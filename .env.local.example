# Copy this file to ".env.local" and fill in your real values.
# Never commit ".env.local" to GitHub — it contains secrets.

# The email address of your Google Service Account
# (looks like: something@your-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The private key from your Service Account's downloaded JSON file.
# Keep the quotes and the \n characters exactly as shown in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID of your Google Sheet — found in its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=
